# Local-only credentials for compose.integration.yaml.
HOST=0.0.0.0
PORT=8080
DATA_ROOT=/data

IMPORTER_ENV_FILE=.env
IMPORTER_HOST_PORT=18080
SONARR_HOST_PORT=18989
QBITTORRENT_HOST_PORT=18081

DEV_PUID=1000
DEV_PGID=1000
TZ=Europe/Moscow

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=0123456789abcdef0123456789abcdef

QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=importer
QBITTORRENT_PASSWORD=importer-dev-qbit-password

PROWLARR_URL=http://fixture-server:8080
PROWLARR_API_KEY=fixture-secret
QBITTORRENT_MEDIA_ROOT=/media/downloads
SONARR_MEDIA_ROOT=/media/downloads
IMPORTER_MEDIA_ROOT=/media/downloads
REVISION_POLL_INTERVAL=1h

REQUEST_TIMEOUT=30s
COMMAND_TIMEOUT=10m
WORKFLOW_TIMEOUT=30m
POLL_INTERVAL=2s

BUILD_VERSION=dev
BUILD_COMMIT_SHA=local
BUILD_TIME=local
IMPORTER_DEV_TAG=dev
QBIT_RENAME_RESPONSE_DELAY=10s
QBIT_ADD_RESPONSE_DELAY=5s
QBIT_DELETE_RESPONSE_DELAY=5s
INTEGRATION_COMMAND_TIMEOUT=2m
INTEGRATION_WORKFLOW_TIMEOUT=5m
