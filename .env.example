HOST=0.0.0.0
PORT=8080
DATA_ROOT=/data

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=replace-with-sonarr-api-key

QBITTORRENT_URL=http://qbittorrent:8080
QBITTORRENT_USERNAME=replace-with-qbittorrent-username
QBITTORRENT_PASSWORD=replace-with-qbittorrent-password

# Optional rolling-release support. Uncomment the whole block and run Compose
# with compose.rolling.example.yaml. Prowlarr indexer Redirect must be disabled.
# PROWLARR_URL=http://prowlarr:9696
# PROWLARR_API_KEY=replace-with-prowlarr-api-key
# QBITTORRENT_MEDIA_ROOT=/downloads
# SONARR_MEDIA_ROOT=/downloads
# IMPORTER_MEDIA_ROOT=/media/qbittorrent
# QBITTORRENT_MEDIA_HOST_PATH=/host/path/used-by-qbittorrent
# QBITTORRENT_MEDIA_GID=1000
# REVISION_POLL_INTERVAL=15m

REQUEST_TIMEOUT=30s
COMMAND_TIMEOUT=10m
WORKFLOW_TIMEOUT=30m
POLL_INTERVAL=2s
